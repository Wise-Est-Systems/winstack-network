# Treat all text files with LF line endings, regardless of host OS.
* text=auto eol=lf

# Force binary diffs (no ambiguity, no merge attempts).
*.wasm    binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.dmg     binary
*.zip     binary
*.tar.gz  binary
*.win     binary

# GitHub linguist — don't count vendored or generated assets in language stats.
public/wasm/*.js  linguist-generated=true
public/wasm/*.ts  linguist-generated=true
Cargo.lock        linguist-generated=true

# Diff hints for non-text-but-readable formats.
*.json   diff=json
