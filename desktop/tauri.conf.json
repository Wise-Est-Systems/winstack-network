{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Winstack",
  "version": "0.1.0",
  "identifier": "systems.wisest.winstack",
  "build": {
    "frontendDist": "../window",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "title": "Winstack",
        "width": 560,
        "height": 680,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "verify.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/1024x1024.png"
    ]
  }
}
