{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Winstack",
  "version": "0.1.0",
  "identifier": "systems.wisest.winstack",
  "build": {
    "frontendDist": "../window",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "title": "Winstack",
        "width": 600,
        "height": 720,
        "resizable": true,
        "center": true,
        "url": "verify.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
